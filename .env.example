# Configurações do Firebase
# Obtenha estas credenciais em: https://console.firebase.google.com/
# Projeto > Configurações > Seus Aplicativos > Web App

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Configurações do Firebase (Opcional)
VITE_FIREBASE_LOAD_TIMEOUT=3000

# Configurações do Vercel (Opcional)
# Estas são configuradas automaticamente pelo Vercel
# VERCEL_URL=your_deployment_url.vercel.app