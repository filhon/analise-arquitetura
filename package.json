{
  "name": "sistema-eleicao-oficiais",
  "version": "2.0.0",
  "description": "Sistema profissional de eleição de oficiais para igrejas",
  "main": "src/main.ts",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext ts,tsx",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "format": "prettier --write src/**/*.{ts,tsx,css,html}",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "firebase": "^12.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.1"
  },
  "keywords": [
    "eleição",
    "igreja",
    "votação",
    "presbíteros",
    "diáconos",
    "ata-presença"
  ],
  "author": "Sistema de Eleição",
  "license": "MIT"
}
